syncwebagent-code(){
    cd ${WEBAGENT_DIR}
    scp webAgent code:/root/game/web-agent/
    scp -r assets code:/root/game/web-agent/
    scp -r views code:/root/game/web-agent/
    scp -r conf code:/root/game/web-agent/
}

clearlog(){
    cd ${LOG_DIR}/
    rm -rf *
}

choose_game_server() {
    options=("origin-game" "mengjiala-game")
    select opt in "${options[@]}"; do
        if [[ -n "$opt" ]]; then
            echo "$opt"
            return 0
        else
            echo ""
            return 0
        fi
    done
}

choose_db_server() {
    options=("origin-db" "mengjiala-db")
    select opt in "${options[@]}"; do
        if [[ -n "$opt" ]]; then
            echo "$opt"
            return 0
        else
            echo ""
            return 0
        fi
    done
}

check_server() {
    if [[ $1 == '' ]]; then
        echo "无效服务器"
        exit 1
    fi
}

publish(){
    server=$(choose_game_server)
    check_server $server
    scp *.bin $server:/home/ubuntu/game
}

publish_table(){
    server=$(choose_game_server)
    check_server $server
    scp -r table $server:/home/ubuntu/game
    scp -r free $server:/home/ubuntu/game
}

publish_web(){
    server=$(choose_db_server)
    check_server $server

    cd ${PROJECT_DIR}
    git pull
    cd ${WEB_DIR}
    go build
    ssh $server "ps aux | grep -w web | grep -v grep | awk '{print \$2}' | xargs kill -9" || true
    scp web $server:/home/ubuntu/web/
    scp -r assets $server:/home/ubuntu/web/
    scp -r views $server:/home/ubuntu/web/
    scp -r conf $server:/home/ubuntu/web/
    ssh $server "cd /home/ubuntu/web/; nohup ./web &> /dev/null &"
}

publish_stats(){
    server=$(choose_db_server)
    check_server $server

    cd ${PROJECT_DIR}
    git pull
    cd ${WEBSTATS_DIR}
    go build
    ssh $server "ps aux | grep -w webStats | grep -v grep | awk '{print \$2}' | xargs kill -9" || true
    scp webStats $server:/home/ubuntu/web-stats/
    # scp -r assets db:/home/ubuntu/web-stats/
    # scp -r views db:/home/ubuntu/web-stats/
    scp -r conf $server:/home/ubuntu/web-stats/
    ssh $server "cd /home/ubuntu/web-stats/; nohup ./webStats &> /dev/null &"
}

refresh-o(){
    aws cloudfront create-invalidation --distribution-id E1H0KE8X3958V1 --paths "/*"
}

refresh-r(){
    aws cloudfront create-invalidation --distribution-id E1YRUVSR9EQ0D6 --paths "/*"
}

refresh-m(){
    aws cloudfront create-invalidation --distribution-id E65XRK5TT4AJO --paths "/*"
}

refresh-all(){
    refresh-o
    refresh-r
    refresh-m
}

case $1 in
    build)
        build $2 $3;;
    buildall)
        build_all;;
    start)
        start $2 $3;;
    startall)
        start_all;;
    stop)
        stop $2 $3;;
    stopall)
        stop_all;;
    restart)
        restart $2 $3;;
    status)
        status $2 $3;;
    show)
        show;;
    proto) 
        proto;; 
    table)
        table;;
    table_m)
        table_m;;
    sync)
        sync;;
    sync_table)
        sync_table;;
    publish)
        publish;;
    publish_table)
        publish_table;;
    publish_web)
        publish_web;;
    publish_stats)
        publish_stats;;
    synctest_table)
        synctest_table;;
    syncgame_table)
        syncgame_table;;
    mjlgame_table)
        mjlgame_table;;
    synctest)
        synctest;;
    syncgame)
        syncgame;;
    syncmjlgame)
        syncmjlgame;;
    buildweb)
        buildweb;;
    sync-w-code)
        syncweb-code;;
    sync-w-test)
        syncweb-test;;
    sync-w-db)
        syncweb-db;;
    sync-mjl-w-db)
        syncmjlweb-db;;
    sync-wa-db)
        syncwebagent-db;;
    sync-wa-test)
        syncwebagent-test;;
    sync-wa-code)
        syncwebagent-code;;
    sync-ws-code)
        syncwebstats-code;;
    sync-ws-test)
        syncwebstats-test;;
    sync-ws-db)
        syncwebstats-db;;
    sync-mjl-ws-db)
        syncmjlwebstats-db;;
    clearlog)
        clearlog;;
    refresh-origin)
        refresh-o;;
    refresh-random)
        refresh-r;;
    refresh-mjl)
        refresh-m;;
    refresh-all)
        refresh-all;;
    *)
        usage;;
esac