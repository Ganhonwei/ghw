gm.host = "127.0.0.1"
gm.port = "8002"
gm.path = "/api/web"
gm.key = "XG0e2Ye/KAUJRXaMNnJ5UH1haBvh2FXOoAggE6f2Utw"
gm.url = "http://127.0.0.1:8002/api/web"
gm.cdn = "https://d29jyri7d3jltj.cloudfront.net/"
