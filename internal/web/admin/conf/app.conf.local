appname = goplays-web
httpport = 18080
runmode = dev
namespace = admin
sessionon = true
timezone="Asia/Dhaka"
#timezone="Asia/Kolkata" 
versions = "mengjiala"
#versions = "PK" 巴基斯坦
copyRequestBody = true
#versions = "origin"
EnableGzip = true
StaticExtensionsToGzip = .css, .js, .json, .svg, .ttf, .woff
gzipCompressLevel = 9
StaticCacheFileSize = 1048576  # 1M
StaticCacheFileNum = 50

# nats
nats.url = "nats://@127.0.0.1:4222"

# 数据库配置
db.host = "127.0.0.1"
db.user = root
db.password = "root"
db.port = 3306
db.name = test
db.prefix = "t_"
db.timezone = "Asia/Shanghai"

# mgo数据库配置
mdb.host = "127.0.0.1"
mdb.user =
mdb.password =
mdb.port = 27017
#mdb.name = huiyindev
mdb.name = test
#mdb.name = huiyintest
mdb.ssh = false
mdb.sshUser = "ubuntu"
mdb.sshAddr = "18.162.188.29:60000"
mdb.sshKey = "/root/.ssh/k8s.pem"

mgodb.host = "127.0.0.1"
mgodb.user =
mgodb.password =
mgodb.port = 27019
#mdb.name = huiyindev
mgodb.name = testlog
#mdb.name = huiyintest
mgodb.ssh = false
mgodb.sshUser = "ubuntu"
mgodb.sshAddr = "18.162.188.29:60000"
mgodb.sshKey = "/root/.ssh/k8s.pem"

# clickhouse
clickhouse.logsql = true
clickhouse.addr  = "127.0.0.1:9000"
clickhouse.database = "game"
clickhouse.username = ""
clickhouse.password = ""
clickhouse.dial_timeout = 10 # second
clickhouse.read_timeout = 20 # second
clickhouse.ssh = false
clickhouse.sshUser = "ubuntu"
clickhouse.sshAddr = "18.162.188.29:60000"
clickhouse.sshKey = "/root/.ssh/k8s.pem"

# NSQ
nsq.addr = "127.0.0.1:4150"

