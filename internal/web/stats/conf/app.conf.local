appname = goplays-web-stats
httpport = 16060
runmode = dev
namespace = admin
timezone="Asia/Dhaka"
#timezone="Asia/Kolkata" 

# 数据库配置
db.host = "127.0.0.1"
db.user = root
db.password = "root"
db.port = 3306
db.name = test
db.prefix = "t_"
db.timezone = "Asia/Shanghai"

# mgo数据库配置
mdb.host = "127.0.0.1"
mdb.user =
mdb.password =
mdb.port = 27017
#mdb.name = huiyindev
mdb.name = test
#mdb.name = huiyintest
mdb.ssh = true
mdb.sshUser = "ubuntu"
mdb.sshAddr = "47.129.223.236:60000"
mdb.sshKey = "./conf/ssh/newtp.pem"

mgodb.host = "127.0.0.1"
mgodb.user =
mgodb.password =
mgodb.port = 27019
#mdb.name = huiyindev
mgodb.name = testlog
#mdb.name = huiyintest
mgodb.ssh = true
mgodb.sshUser = "ubuntu"
mgodb.sshAddr = "47.129.223.236:60000"
mgodb.sshKey = "./conf/ssh/newtp.pem"

# clickhouse
clickhouse.logsql = true
clickhouse.addr  = "192.168.0.137:9000"
clickhouse.database = "game"
clickhouse.username = ""
clickhouse.password = ""
clickhouse.dial_timeout = 10 # second
clickhouse.read_timeout = 20 # second
clickhouse.ssh = true
clickhouse.sshUser = "ubuntu"
clickhouse.sshAddr = "47.129.223.236:60000"
clickhouse.sshKey = "./conf/ssh/newtp.pem"

# 数据目录设置
