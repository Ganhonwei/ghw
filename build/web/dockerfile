##############################################################################
FROM golang:1.23.4 AS builder

ARG BUILD_TYPE=release

ENV CGO_ENABLED=0
ENV GOPROXY=https://goproxy.cn,direct

WORKDIR /build

COPY go.mod go.sum ./
COPY third_party ./third_party

RUN go mod download

RUN apt-get update && \
    apt-get install -y wget xz-utils && \
    wget https://github.com/upx/upx/releases/download/v4.2.4/upx-4.2.4-amd64_linux.tar.xz && \
    tar -xf upx-4.2.4-amd64_linux.tar.xz && \
    mv upx-4.2.4-amd64_linux/upx /usr/local/bin/ && \
    rm -rf upx-4.0.2-amd64_linux*

COPY . .

RUN --mount=type=cache,target=/root/.cache/go-build \
    if [ "${BUILD_TYPE}" = "debug" ]; then \
        go build -gcflags="all=-N -l" -o web ./cmd/web; \
    else \
        go build -ldflags "-s -w" -o web ./cmd/web; \
    fi

RUN if [ "${BUILD_TYPE}" = "debug" ]; then \
        go install github.com/go-delve/delve/cmd/dlv@latest; \
    else \
        upx -1 web; \
    fi
##############################################################################
FROM alpine:latest AS web

ARG BUILD_TYPE=release
ENV BUILD_TYPE=${BUILD_TYPE}

RUN apk add --no-cache tzdata
RUN apk add --no-cache curl

WORKDIR /app

COPY --from=builder /build/web .
COPY build/web/entrypoint.sh /

RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
##############################################################################
FROM alpine:latest AS web-debug

ARG BUILD_TYPE=release
ENV BUILD_TYPE=${BUILD_TYPE}

RUN apk add --no-cache tzdata
RUN apk add --no-cache curl

WORKDIR /app

COPY --from=builder /build/web .
COPY --from=builder /go/bin/dlv /usr/local/bin/dlv
COPY build/web/entrypoint.sh /

RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
##############################################################################



























